From 607d6033a5fb191bcab588218cc72f0ea143a22b Mon Sep 17 00:00:00 2001
From: Claude <dev@example.com>
Date: Sun, 9 Aug 2026 15:07:33 +0000
Subject: [PATCH] fix(prisma): actually apply the RLS migration-ordering fix
 (P3009)

20260803090000_enable_row_level_security tried to ALTER TABLE ... ENABLE
ROW LEVEL SECURITY on SupportTicket and SupportTicketMessage, but those
tables aren't created until the later 20260804090000_add_support_tickets
migration. On a database applying all migrations from scratch in order,
this made 20260803090000 fail with 'relation does not exist', which then
blocks every later migration behind a P3009 error until resolved.

0009-fix-rls-migration-ordering-support-tickets.patch at the repo root
already diagnosed this and added 20260809140000_enable_rls_support_tickets
to enable RLS on those two tables at the correct point in history - but
the other half of that fix, removing the two premature lines from
20260803090000, was never actually applied. The loose .patch file was
committed as-is instead of being applied, so the bug it described was
still live. This commit finishes that fix and removes the now-redundant
patch file.

To unblock a database that already hit this (P3009: found failed
migrations), run against production BEFORE redeploying:

    npx prisma migrate resolve --rolled-back "20260803090000_enable_row_level_security"

Safe to run: the whole migration.sql runs in one transaction, so Postgres
already rolled back anything it started applying when it hit the missing
table - nothing was left half-applied. This command only updates Prisma's
own _prisma_migrations bookkeeping table so migrate deploy will retry
20260803090000 (now fixed) on the next deploy instead of refusing to
proceed.
---
 ...s-migration-ordering-support-tickets.patch | 31 -------------------
 .../migration.sql                             |  9 ++++--
 2 files changed, 7 insertions(+), 33 deletions(-)
 delete mode 100644 0009-fix-rls-migration-ordering-support-tickets.patch

diff --git a/0009-fix-rls-migration-ordering-support-tickets.patch b/0009-fix-rls-migration-ordering-support-tickets.patch
deleted file mode 100644
index a3da133..0000000
--- a/0009-fix-rls-migration-ordering-support-tickets.patch
+++ /dev/null
@@ -1,31 +0,0 @@
-diff --git a/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql b/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql
-index 15c93b1..1140a45 100644
---- a/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql
-+++ b/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql
-@@ -32,8 +32,6 @@ ALTER TABLE "RefreshToken" ENABLE ROW LEVEL SECURITY;
- ALTER TABLE "Transaction" ENABLE ROW LEVEL SECURITY;
- ALTER TABLE "DataPlanPricing" ENABLE ROW LEVEL SECURITY;
- ALTER TABLE "ServicePricing" ENABLE ROW LEVEL SECURITY;
--ALTER TABLE "SupportTicket" ENABLE ROW LEVEL SECURITY;
--ALTER TABLE "SupportTicketMessage" ENABLE ROW LEVEL SECURITY;
- ALTER TABLE "ReferralSettings" ENABLE ROW LEVEL SECURITY;
- ALTER TABLE "Coupon" ENABLE ROW LEVEL SECURITY;
- ALTER TABLE "ProviderBalanceStatus" ENABLE ROW LEVEL SECURITY;
-diff --git a/major_data_link_backend/prisma/migrations/20260809140000_enable_rls_support_tickets/migration.sql b/major_data_link_backend/prisma/migrations/20260809140000_enable_rls_support_tickets/migration.sql
-new file mode 100644
-index 0000000..00e473f
---- /dev/null
-+++ b/major_data_link_backend/prisma/migrations/20260809140000_enable_rls_support_tickets/migration.sql
-@@ -0,0 +1,12 @@
-+-- Split out of 20260803090000_enable_row_level_security, which ran BEFORE
-+-- these two tables existed (they were created a day later, in
-+-- 20260804090000_add_support_tickets) and so failed with "relation does
-+-- not exist" when it reached these two lines. Same reasoning as that
-+-- migration applies here: the backend accesses these tables as the
-+-- Postgres owner role, which RLS never restricts, so this only closes
-+-- off Supabase's separate PostgREST path - see the comment in
-+-- 20260803090000_enable_row_level_security/migration.sql for the full
-+-- explanation.
-+
-+ALTER TABLE "SupportTicket" ENABLE ROW LEVEL SECURITY;
-+ALTER TABLE "SupportTicketMessage" ENABLE ROW LEVEL SECURITY;
diff --git a/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql b/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql
index e93da1d..853ef17 100644
--- a/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql
+++ b/major_data_link_backend/prisma/migrations/20260803090000_enable_row_level_security/migration.sql
@@ -40,8 +40,13 @@ ALTER TABLE "Notification" ENABLE ROW LEVEL SECURITY;
 ALTER TABLE "NotificationBroadcast" ENABLE ROW LEVEL SECURITY;
 ALTER TABLE "AdminUser" ENABLE ROW LEVEL SECURITY;
 ALTER TABLE "AdminAuditLog" ENABLE ROW LEVEL SECURITY;
-ALTER TABLE "SupportTicket" ENABLE ROW LEVEL SECURITY;
-ALTER TABLE "SupportTicketMessage" ENABLE ROW LEVEL SECURITY;
+
+-- SupportTicket / SupportTicketMessage were intentionally NOT added here.
+-- Those two tables don't exist yet at this point in migration history (they're
+-- created later, in 20260804090000_add_support_tickets) - enabling RLS on them
+-- from this migration made a fresh database applying all migrations in order
+-- fail with "relation does not exist". Enabling RLS on them was moved to
+-- 20260809140000_enable_rls_support_tickets, which runs after that table exists.
 
 -- Prisma's own internal migration-tracking table also lives in the public
 -- schema, so Supabase's linter flags it too even though it holds no user
