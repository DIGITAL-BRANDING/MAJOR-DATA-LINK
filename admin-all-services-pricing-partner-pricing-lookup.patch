+    final start = widget.row.partnerSellingPrice ??
+        widget.row.sellingPrice ??
+        widget.row.providerCost;
+    _controller = TextEditingController(text: start.toStringAsFixed(0));
+  }
+
+  @override
+  void dispose() {
