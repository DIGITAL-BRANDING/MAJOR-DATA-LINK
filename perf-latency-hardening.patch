new file mode 100644
index 0000000..264917f
--- /dev/null
+++ b/major_data_link_backend/src/lib/http.ts
@@ -0,0 +1,107 @@
+import { env } from '../config/env.js';
+import { ApiError } from '../middleware/error.js';
+
+/**
+ * Bounded-latency wrapper around fetch() for every call this backend makes to
+ * a third party (Alrahuz, BilalSadaSub, Paystack, KatPay, WhatsApp, ...).
+ *
+ * WHY THIS EXISTS
+ * Node's fetch() has no default timeout. A provider that accepts the TCP
+ * connection and then stalls holds the calling request open indefinitely -
+ * the customer sees an endless spinner, and any DB connection / event-loop
+ * work tied to that request is held with it. Every upstream call must have a
+ * ceiling, and that ceiling must be enforced in ONE place so nobody has to
+ * remember to add it at each call site.
+ *
+ * TIMEOUT SEMANTICS
+ * A timeout means "we stopped waiting", NOT "the provider did nothing". For
+ * read-only calls that distinction is irrelevant. For money-moving calls the
+ * provider may still fulfil the request after we give up, so callers MUST NOT
+ * treat UpstreamTimeoutError as a confirmed failure (no auto-refund) - see the
+ * `pending` handling in provider.service.ts / bilalsadasub.service.ts.
+ */
+
+/** Thrown when an upstream call exceeds its time budget. HTTP 504 by default. */
+export class UpstreamTimeoutError extends ApiError {
+  constructor(
+    public readonly service: string,
+    public readonly timeoutMs: number
+  ) {
+    super(504, `${service} did not respond in time. Please try again shortly.`, 'UPSTREAM_TIMEOUT');
+    this.name = 'UpstreamTimeoutError';
+  }
+}
+
+export type UpstreamFetchOptions = {
+  /** Overrides the default read timeout. Use purchaseTimeoutMs() for money-moving calls. */
+  timeoutMs?: number;
+};
+
+export const readTimeoutMs = () => env.UPSTREAM_READ_TIMEOUT_MS ?? 10_000;
+export const purchaseTimeoutMs = () => env.UPSTREAM_PURCHASE_TIMEOUT_MS ?? 30_000;
+const slowUpstreamMs = () => env.SLOW_UPSTREAM_MS ?? 2_000;
+
+function isTimeoutAbort(error: unknown): boolean {
+  return (
+    typeof error === 'object' &&
+    error !== null &&
+    'name' in error &&
+    ((error as { name: string }).name === 'TimeoutError' || (error as { name: string }).name === 'AbortError')
+  );
+}
+
+/**
+ * fetch() with a hard time budget. Behaves exactly like fetch() otherwise:
+ * non-timeout failures (DNS, connection refused, TLS) are re-thrown untouched
+ * so existing error handling at each call site keeps working unchanged.
+ * A caller-supplied `init.signal` is honoured and combined with the timeout.
+ */
+export async function fetchWithTimeout(
+  service: string,
+  input: string | URL,
+  init: RequestInit = {},
+  options: UpstreamFetchOptions = {}
+): Promise<Response> {
+  const timeoutMs = options.timeoutMs ?? readTimeoutMs();
+  const timeoutSignal = AbortSignal.timeout(timeoutMs);
+  const signal = init.signal ? AbortSignal.any([init.signal, timeoutSignal]) : timeoutSignal;
+  const startedAt = Date.now();
+
+  try {
+    const response = await fetch(input, { ...init, signal });
+    const elapsed = Date.now() - startedAt;
+    if (elapsed >= slowUpstreamMs()) {
+      console.warn(`[slow-upstream] ${service} ${init.method ?? 'GET'} ${describeTarget(input)} status=${response.status} ${elapsed}ms`);
+    }
+    return response;
+  } catch (error) {
+    // Only translate OUR timeout. If the caller aborted on purpose, or the
+    // failure is something else entirely, let it propagate unchanged.
+    if (timeoutSignal.aborted && isTimeoutAbort(error)) {
+      console.error(`[upstream-timeout] ${service} ${init.method ?? 'GET'} ${describeTarget(input)} gave up after ${timeoutMs}ms`);
+      throw new UpstreamTimeoutError(service, timeoutMs);
+    }
+    throw error;
+  }
+}
+
+/**
+ * Binds a service name once so call sites stay a drop-in replacement for
+ * fetch(): `const paystackFetch = createUpstreamFetch('paystack')`, then
+ * `paystackFetch(url, init)`. Pass `{ timeoutMs: purchaseTimeoutMs() }` as the
+ * third argument for money-moving calls.
+ */
+export function createUpstreamFetch(service: string) {
+  return (input: string | URL, init?: RequestInit, options?: UpstreamFetchOptions) =>
+    fetchWithTimeout(service, input, init, options);
+}
+
+/** Path only - never log query strings (they can carry phone numbers / references). */
+function describeTarget(input: string | URL): string {
+  try {
+    const url = typeof input === 'string' ? new URL(input) : input;
+    return `${url.host}${url.pathname}`;
+  } catch {
+    return 'unparseable-url';
+  }
+}
