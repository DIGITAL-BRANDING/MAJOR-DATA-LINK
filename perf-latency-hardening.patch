+  // Times EVERY query (including those inside interactive transactions) and
+  // attributes it to the current HTTP request. The measured time is what the
+  // caller actually waited: database execution + network round trip + time
+  // spent waiting for a free connection in Prisma's pool. If many unrelated
+  // queries are slow at once, suspect the pool or the network, not the SQL.
+  // Arguments are never logged - they contain phone numbers, references, etc.
+  //
+  // Uses $use() rather than $extends() deliberately: an extended client is not
+  // assignable to Prisma.TransactionClient, which several services
+  // (wallet.service.ts, provider-ledger.service.ts, ...) use to type their
+  // `tx` parameters, so $extends would force a signature change across the
+  // money-handling code for a diagnostics feature. $use() leaves every type
+  // untouched. It is deprecated in Prisma 5 and removed in Prisma 6 - when
+  // upgrading, port this hook to $extends together with those signatures.
+  client.$use(async (params, next) => {
+    const startedAt = performance.now();
+    try {
+      return await next(params);
+    } finally {
+      const ms = performance.now() - startedAt;
+      const label = params.model ? `${params.model}.${params.action}` : params.action;
+      recordDbQuery(label, ms);
+      if (ms >= SLOW_QUERY_MS) {
+        console.warn(`[slow-query] ${label} ${Math.round(ms)}ms`);
+      }
+    }
+  });
+
+  return client;
 };
 
