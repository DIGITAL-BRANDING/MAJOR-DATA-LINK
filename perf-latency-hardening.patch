+++ b/major_data_link_backend/src/services/__tests__/payment-provider.ensure-va.test.ts
@@ -0,0 +1,113 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+/**
+ * ensureVirtualAccount() is what /user/profile and /wallet/* call instead of
+ * awaiting a live payment-gateway request inline. These tests pin the three
+ * properties that stop a broken gateway from slowing down every screen:
+ * single-flight, per-user cooldown, and a bounded (or zero) wait.
+ */
+
+const mockEnv = vi.hoisted((): Record<string, unknown> => ({ PAYMENT_PROVIDER: 'paystack' }));
+vi.mock('../../config/env.js', () => ({ env: mockEnv }));
+vi.mock('../../lib/prisma.js', () => ({ prisma: {} }));
+vi.mock('../katpay.service.js', () => ({ katpayService: {} }));
+vi.mock('../paystack.service.js', () => ({ paystackService: {} }));
+
+const provision = vi.hoisted(() => vi.fn());
+vi.mock('../kyc.service.js', () => ({
+  tryProvisionInstantVirtualAccount: (...args: unknown[]) => provision(...args)
+}));
+
+import { ensureVirtualAccount } from '../payment-provider.service.js';
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+let userCounter = 0;
+const newUser = () => `user-${(userCounter += 1)}`;
+
+beforeEach(() => {
+  provision.mockReset();
+  provision.mockResolvedValue(undefined);
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe('ensureVirtualAccount', () => {
+  it('waitMs: 0 returns immediately even when the gateway never answers, and still starts the attempt', async () => {
+    provision.mockReturnValue(new Promise(() => {})); // gateway hangs forever
+    const userId = newUser();
+
+    const startedAt = Date.now();
+    const finishedInTime = await ensureVirtualAccount(userId, { waitMs: 0 });
+
+    expect(finishedInTime).toBe(false);
+    expect(Date.now() - startedAt).toBeLessThan(50);
+    expect(provision).toHaveBeenCalledTimes(1);
+    expect(provision).toHaveBeenCalledWith(userId);
+  });
+
+  it('shares one attempt between concurrent callers for the same user (single-flight)', async () => {
+    let release!: () => void;
+    provision.mockReturnValue(new Promise<void>((resolve) => (release = resolve)));
+    const userId = newUser();
+
+    const first = ensureVirtualAccount(userId, { waitMs: 1_000 });
+    const second = ensureVirtualAccount(userId, { waitMs: 1_000 });
+    release();
+
+    expect(await first).toBe(true);
+    expect(await second).toBe(true);
+    expect(provision).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not retry the same user inside the cooldown, even after a failure, then retries once it expires', async () => {
+    vi.useFakeTimers({ toFake: ['Date'] });
+    vi.setSystemTime(new Date('2026-09-24T10:00:00Z'));
+    provision.mockRejectedValue(new Error('gateway down'));
+    const userId = newUser();
+
+    await ensureVirtualAccount(userId, { waitMs: 1_000 });
+    expect(provision).toHaveBeenCalledTimes(1);
+
+    // Every screen refresh in the next few minutes: no further gateway calls.
+    vi.setSystemTime(new Date('2026-09-24T10:05:00Z'));
+    expect(await ensureVirtualAccount(userId, { waitMs: 1_000 })).toBe(false);
+    expect(provision).toHaveBeenCalledTimes(1);
+
+    // Cooldown (10 minutes) over: one more attempt is allowed.
+    vi.setSystemTime(new Date('2026-09-24T10:10:01Z'));
+    await ensureVirtualAccount(userId, { waitMs: 1_000 });
+    expect(provision).toHaveBeenCalledTimes(2);
+  });
+
+  it('gives up waiting after waitMs but lets the attempt finish in the background', async () => {
+    let finished = false;
+    provision.mockImplementation(async () => {
+      await sleep(200);
+      finished = true;
+    });
+    const userId = newUser();
+
+    const startedAt = Date.now();
+    const finishedInTime = await ensureVirtualAccount(userId, { waitMs: 40 });
+
+    expect(finishedInTime).toBe(false);
+    expect(Date.now() - startedAt).toBeLessThan(150);
+    expect(finished).toBe(false);
+    await sleep(250);
+    expect(finished).toBe(true);
+  });
+
+  it('reports true when the attempt completes within the wait, so callers know to re-read the user', async () => {
+    provision.mockImplementation(() => sleep(10));
+    expect(await ensureVirtualAccount(newUser(), { waitMs: 500 })).toBe(true);
+  });
+
+  it('never rejects: an unexpected provisioning error cannot become an unhandled rejection', async () => {
+    provision.mockRejectedValue(new Error('boom'));
+    await expect(ensureVirtualAccount(newUser(), { waitMs: 500 })).resolves.toBe(true);
+    await expect(ensureVirtualAccount(newUser(), { waitMs: 0 })).resolves.toBe(false);
+    await sleep(20); // let the background attempt settle; vitest fails the run on unhandled rejections
+  });
+});
diff --git a/major_data_link_backend/src/services/__tests__/provider-timeouts.test.ts b/major_data_link_backend/src/services/__tests__/provider-timeouts.test.ts
