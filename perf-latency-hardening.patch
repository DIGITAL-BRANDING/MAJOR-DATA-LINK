--- /dev/null
+++ b/major_data_link_backend/src/services/__tests__/provider-timeouts.test.ts
@@ -0,0 +1,117 @@
+import http from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+
+/**
+ * Money-safety tests for provider timeouts.
+ *
+ * A purchase that times out is AMBIGUOUS: we stopped waiting, but the provider
+ * may still fulfil it. It must therefore come back as `pending` (which every
+ * purchase route sends to /admin/provider-reconciliation) and must NEVER come
+ * back as a plain failure (which the routes answer with an automatic refund -
+ * paying the customer back for a purchase that then lands).
+ *
+ * These tests run against a real local HTTP server that accepts requests and
+ * then stalls, exactly like the provider outage they guard against.
+ */
+
+const mockEnv = vi.hoisted((): Record<string, unknown> => ({
+  MOCK_PROVIDER: false,
+  ALRAHUZ_BASE_URL: 'http://placeholder',
+  ALRAHUZ_API_TOKEN: 'alrahuz-token',
+  BILALSADASUB_BASE_URL: 'http://placeholder',
+  BILALSADASUB_USERNAME: 'user',
+  BILALSADASUB_PASSWORD: 'pass',
+  BILALSADASUB_LOW_BALANCE_THRESHOLD: 2000,
+  BILALSADASUB_LOW_BALANCE_ALERT_COOLDOWN_MINUTES: 60,
+  UPSTREAM_READ_TIMEOUT_MS: 150,
+  UPSTREAM_PURCHASE_TIMEOUT_MS: 150,
+  SLOW_UPSTREAM_MS: 60_000
+}));
+
+vi.mock('../../config/env.js', () => ({ env: mockEnv }));
+vi.mock('../../lib/prisma.js', () => ({ prisma: {} }));
+vi.mock('../data-plan-pricing.service.js', () => ({ dataPlanPricingService: {} }));
+
+import * as bilal from '../bilalsadasub.service.js';
+import { UpstreamTimeoutError } from '../../lib/http.js';
+import { providerService } from '../provider.service.js';
+import type { NormalizedProviderResponse } from '../provider-types.js';
+
+let server: http.Server;
+let tokenEndpointHangs = true;
+
+beforeAll(async () => {
+  server = http.createServer((req, res) => {
+    const url = req.url ?? '';
+    res.setHeader('content-type', 'application/json');
+
+    if (url === '/api/user') {
+      if (tokenEndpointHangs) return; // stall the auth call
+      res.end(JSON.stringify({ status: 'success', AccessToken: 'tok' }));
+      return;
+    }
+    if (url === '/api/bill') {
+      res.end(JSON.stringify({ status: 'success', message: 'Token generated', 'request-id': 'REF-OK', token: '1234-5678', units: '10' }));
+      return;
+    }
+    // Everything else (Bilal /api/data, /api/cable, Alrahuz /data/, /topup/): accept and stall.
+  });
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  const base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+  mockEnv.ALRAHUZ_BASE_URL = `${base}/alrahuz`;
+  mockEnv.BILALSADASUB_BASE_URL = base;
+});
+
+afterAll(async () => {
+  server.closeAllConnections();
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+});
+
+describe('BilalSadaSub purchase timeouts', () => {
+  it('a timeout while AUTHENTICATING is a plain error - nothing was sent, so nothing to reconcile', async () => {
+    tokenEndpointHangs = true;
+    await expect(
+      bilal.buyData({ network: 'MTN', phone: '08030000000', planId: '1', reference: 'REF-AUTH' })
+    ).rejects.toBeInstanceOf(UpstreamTimeoutError);
+  });
+
