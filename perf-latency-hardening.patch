@@ -0,0 +1,27 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+
+/**
+ * Per-request database timing, carried through async boundaries with
+ * AsyncLocalStorage so the Prisma query hook (lib/prisma.ts) can attribute
+ * every query to the HTTP request that caused it without threading a context
+ * object through every service function.
+ *
+ * Deliberately dependency-free: both lib/prisma.ts and lib/diagnostics.ts
+ * import this file, so it must not import either of them.
+ */
+export type RequestStats = {
+  dbQueries: number;
+  dbMs: number;
+  slowest?: { label: string; ms: number };
+};
+
+export const requestStats = new AsyncLocalStorage<RequestStats>();
+
+/** Records one finished query against the current request (no-op outside a request). */
+export function recordDbQuery(label: string, ms: number): void {
+  const stats = requestStats.getStore();
+  if (!stats) return;
+  stats.dbQueries += 1;
+  stats.dbMs += ms;
+  if (!stats.slowest || ms > stats.slowest.ms) stats.slowest = { label, ms };
+}
