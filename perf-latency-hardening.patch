+-- Payment webhooks resolve the wallet owner with
+--   prisma.user.findFirst({ where: { virtualAccountNumber } })   (wallet.service.ts)
+--   prisma.user.findFirst({ where: { paystackCustomerCode } })   (wallet.service.ts)
+-- Neither column was indexed, so every webhook scanned the whole "User" table.
+--
+-- IF NOT EXISTS keeps this idempotent (safe if an index was added by hand while
+-- diagnosing). Plain CREATE INDEX (not CONCURRENTLY) because Prisma runs each
+-- migration inside a transaction; the build is a brief lock on "User" writes,
+-- which is negligible at this table size.
+
+-- CreateIndex
+CREATE INDEX IF NOT EXISTS "User_virtualAccountNumber_idx" ON "User"("virtualAccountNumber");
+
+-- CreateIndex
+CREATE INDEX IF NOT EXISTS "User_paystackCustomerCode_idx" ON "User"("paystackCustomerCode");
