+import type { AddressInfo } from 'node:net';
+import type http from 'node:http';
+import express from 'express';
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('../../config/env.js', () => ({ env: { SLOW_REQUEST_MS: 50 } }));
+vi.mock('../prisma.js', () => ({ prisma: {} }));
+
+import { requestDiagnostics } from '../diagnostics.js';
+import { recordDbQuery } from '../request-context.js';
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+let server: http.Server;
+let baseUrl: string;
+const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+
+const slowRequestLines = () =>
+  warn.mock.calls.map((call) => String(call[0])).filter((line) => line.startsWith('[slow-request]'));
+
+beforeAll(async () => {
+  const app = express();
+  app.use(requestDiagnostics);
+  app.get('/fast', (_req, res) => res.json({ ok: true }));
+  app.get('/slow', async (_req, res) => {
+    // Two queries in this request (30ms + 5ms), attributed via AsyncLocalStorage
+    // across an await, exactly like real handlers.
+    recordDbQuery('User.findUnique', 30);
+    await sleep(70);
+    recordDbQuery('Transaction.create', 5);
+    res.json({ ok: true });
+  });
+  app.get('/hang', () => {
+    /* never responds */
+  });
+  await new Promise<void>((resolve) => {
+    server = app.listen(0, '127.0.0.1', () => resolve());
+  });
+  baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+
+afterAll(async () => {
+  server.closeAllConnections();
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+});
+
+beforeEach(() => warn.mockClear());
+
+describe('requestDiagnostics', () => {
+  it('stays silent for fast requests', async () => {
+    await fetch(`${baseUrl}/fast`);
+    await sleep(20);
+    expect(slowRequestLines()).toEqual([]);
+  });
+
+  it('logs slow requests with the route, status and the DB share broken out', async () => {
+    await fetch(`${baseUrl}/slow?phone=08030000000`);
+    await sleep(20);
+
+    const [line] = slowRequestLines();
+    expect(line).toMatch(/^\[slow-request\] GET \/slow status=200 total=\d+ms db=35ms\/2q slowest=User\.findUnique:30ms$/);
+    // Query strings can carry phone numbers/references and must never be logged.
+    expect(line).not.toContain('0803');
+    expect(line).not.toContain('?');
+  });
+
+  it('logs a request the client gave up on, even if it was not slow to begin with', async () => {
+    const controller = new AbortController();
+    const pending = fetch(`${baseUrl}/hang`, { signal: controller.signal }).catch(() => undefined);
+    await sleep(10);
+    controller.abort();
+    await pending;
+    await sleep(50);
+
+    const [line] = slowRequestLines();
+    expect(line).toContain('GET /hang');
+    expect(line).toContain('CLIENT_GAVE_UP');
+  });
+});
