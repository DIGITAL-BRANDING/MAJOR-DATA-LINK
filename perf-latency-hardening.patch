+// --- Request-path-safe provisioning --------------------------------------
+//
+// provisionInstantVirtualAccount() makes a live call to Paystack/KatPay. Some
+// GET endpoints (/user/profile, /wallet/balance, /wallet/virtual-account) used
+// to await it INLINE whenever a user had no virtual account yet. For any user
+// whose provisioning keeps failing (gateway outage, bad KYC data, a paused
+// KatPay account) that meant EVERY screen refresh re-ran a slow external call
+// before the response could be sent - the "everything loads forever" symptom.
+//
+// ensureVirtualAccount() keeps the self-healing behaviour but makes it safe to
+// call from a request handler:
+//  - single-flight: concurrent requests for one user share a single attempt;
+//  - cooldown: after an attempt (success OR failure) the same user is not
+//    retried for PROVISION_RETRY_COOLDOWN_MS, so a broken gateway costs one
+//    call per user per window instead of one per request;
+//  - bounded wait: the caller chooses how long it is willing to wait
+//    (waitMs: 0 = fire-and-forget); the attempt keeps running in the
+//    background either way.
+// State is per-process (fine: worst case another instance retries once).
+const PROVISION_RETRY_COOLDOWN_MS = 10 * 60_000;
+const PROVISION_STATE_MAX_ENTRIES = 5_000;
+const lastProvisionAttemptAt = new Map<string, number>();
+const provisionInFlight = new Map<string, Promise<void>>();
+
+function pruneProvisionState(now: number) {
+  if (lastProvisionAttemptAt.size <= PROVISION_STATE_MAX_ENTRIES) return;
+  for (const [userId, at] of lastProvisionAttemptAt) {
+    if (now - at >= PROVISION_RETRY_COOLDOWN_MS) lastProvisionAttemptAt.delete(userId);
+  }
+}
+
+/**
+ * @returns true when an attempt finished within `waitMs` (so the caller should
+ * re-read the user); false when skipped (cooldown), still running, or waitMs is 0.
+ */
+export async function ensureVirtualAccount(userId: string, options: { waitMs: number }): Promise<boolean> {
+  let attempt = provisionInFlight.get(userId);
+
+  if (!attempt) {
+    const now = Date.now();
+    const last = lastProvisionAttemptAt.get(userId);
+    if (last !== undefined && now - last < PROVISION_RETRY_COOLDOWN_MS) return false;
+
+    pruneProvisionState(now);
+    lastProvisionAttemptAt.set(userId, now);
+    attempt = provisionInstantVirtualAccount(userId)
+      .then(() => undefined)
+      .catch((error) => {
+        // provisionInstantVirtualAccount() already swallows expected failures;
+        // this only catches the unexpected so a background attempt can never
+        // become an unhandled rejection (server.ts exits the process on those).
+        console.warn(`[payment-provider] background virtual account provisioning failed for user ${userId}:`, error instanceof Error ? error.message : error);
+      })
+      .finally(() => {
+        provisionInFlight.delete(userId);
+      });
+    provisionInFlight.set(userId, attempt);
+  }
+
+  if (options.waitMs <= 0) return false;
+
+  let timer: NodeJS.Timeout | undefined;
+  const timedOut = new Promise<false>((resolve) => {
+    timer = setTimeout(() => resolve(false), options.waitMs);
+    timer.unref();
+  });
+  try {
+    return await Promise.race([attempt.then(() => true as const), timedOut]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
