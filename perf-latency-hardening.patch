+import http from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+
+vi.mock('../../config/env.js', () => ({
+  env: { UPSTREAM_READ_TIMEOUT_MS: 400, UPSTREAM_PURCHASE_TIMEOUT_MS: 2_000, SLOW_UPSTREAM_MS: 60_000 }
+}));
+
+import { UpstreamTimeoutError, createUpstreamFetch, fetchWithTimeout } from '../http.js';
+
+let server: http.Server;
+let baseUrl: string;
+
+beforeAll(async () => {
+  server = http.createServer((req, res) => {
+    if (req.url === '/fast') {
+      res.setHeader('content-type', 'application/json');
+      res.end(JSON.stringify({ ok: true }));
+      return;
+    }
+    if (req.url === '/hang') return; // accept the request, never answer
+    if (req.url === '/slow-300') {
+      setTimeout(() => res.end('late'), 300);
+      return;
+    }
+    res.statusCode = 404;
+    res.end();
+  });
+  await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+  baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+
+afterAll(async () => {
+  server.closeAllConnections();
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+});
+
+describe('fetchWithTimeout', () => {
+  it('returns the response untouched when the upstream answers in time', async () => {
+    const response = await fetchWithTimeout('svc', `${baseUrl}/fast`);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ ok: true });
+  });
+
+  it('throws UpstreamTimeoutError (HTTP 504, stable code) when the upstream never answers', async () => {
+    const startedAt = Date.now();
+    const error = await fetchWithTimeout('alrahuz', `${baseUrl}/hang`, {}, { timeoutMs: 100 }).catch((e) => e);
+
+    expect(error).toBeInstanceOf(UpstreamTimeoutError);
+    expect(error.statusCode).toBe(504);
+    expect(error.code).toBe('UPSTREAM_TIMEOUT');
+    expect(error.service).toBe('alrahuz');
+    expect(error.timeoutMs).toBe(100);
+    // It must give up near the budget, not wait for the server.
+    expect(Date.now() - startedAt).toBeLessThan(1_000);
+  });
+
+  it('uses UPSTREAM_READ_TIMEOUT_MS by default and honours a per-call override', async () => {
+    // Default read budget is 400ms in this test's env mock; the upstream needs 300ms -> passes.
+    await expect(fetchWithTimeout('svc', `${baseUrl}/slow-300`)).resolves.toBeInstanceOf(Response);
+    // Override tighter than the upstream's latency -> times out.
+    await expect(fetchWithTimeout('svc', `${baseUrl}/slow-300`, {}, { timeoutMs: 100 })).rejects.toBeInstanceOf(
+      UpstreamTimeoutError
+    );
+  });
+
+  it('re-throws non-timeout failures unchanged so existing error handling keeps working', async () => {
+    // Port 1 on loopback: connection refused, immediately.
+    const error = await fetchWithTimeout('svc', 'http://127.0.0.1:1/nope').catch((e) => e);
+    expect(error).not.toBeInstanceOf(UpstreamTimeoutError);
+    expect(error).toBeInstanceOf(Error);
+  });
+
+  it('does not disguise a caller-initiated abort as an upstream timeout', async () => {
+    const controller = new AbortController();
+    const pending = fetchWithTimeout('svc', `${baseUrl}/hang`, { signal: controller.signal }, { timeoutMs: 5_000 });
+    setTimeout(() => controller.abort(), 30);
+    const error = await pending.catch((e) => e);
+    expect(error).not.toBeInstanceOf(UpstreamTimeoutError);
+    expect(error.name).toBe('AbortError');
+  });
+});
+
+describe('createUpstreamFetch', () => {
+  it('is a drop-in fetch replacement bound to a service name', async () => {
+    const upstream = createUpstreamFetch('paystack');
+    const timeout = await upstream(`${baseUrl}/hang`, undefined, { timeoutMs: 80 }).catch((e) => e);
+    expect(timeout).toBeInstanceOf(UpstreamTimeoutError);
+    expect(timeout.service).toBe('paystack');
+  });
+});
diff --git a/major_data_link_backend/src/lib/diagnostics.ts b/major_data_link_backend/src/lib/diagnostics.ts
new file mode 100644
index 0000000..f7a0d37
--- /dev/null
+++ b/major_data_link_backend/src/lib/diagnostics.ts
@@ -0,0 +1,127 @@
+import { monitorEventLoopDelay } from 'node:perf_hooks';
+import type { NextFunction, Request, Response } from 'express';
+import { env } from '../config/env.js';
+import { prisma } from './prisma.js';
+import { requestStats, type RequestStats } from './request-context.js';
+
+/**
+ * Latency diagnostics. Everything here is log-only and read-only: it never
+ * changes a response, never blocks a request, and never logs request bodies,
+ * headers, query strings or query arguments (they carry phone numbers, PINs
+ * and references).
+ *
+ * The goal is to make "the app feels slow" answerable from Railway logs by
+ * telling four different causes apart, each with its own greppable prefix:
+ *
+ *   [db]            startup: round-trip latency to the database + pool config
+ *   [slow-query]    one database call took long (see lib/prisma.ts)
+ *   [slow-upstream] one provider/gateway call took long (see lib/http.ts)
+ *   [event-loop]    Node itself was busy (CPU-bound work such as bcrypt)
+ *   [slow-request]  a whole request took long, with its DB share broken out
+ */
+
+/** Logs requests slower than SLOW_REQUEST_MS, and requests the client gave up on. */
+export function requestDiagnostics(req: Request, res: Response, next: NextFunction) {
+  const stats: RequestStats = { dbQueries: 0, dbMs: 0 };
+  const startedAt = process.hrtime.bigint();
+
+  res.once('close', () => {
+    const totalMs = Number(process.hrtime.bigint() - startedAt) / 1e6;
+    const aborted = !res.writableFinished;
+    if (totalMs < env.SLOW_REQUEST_MS && !aborted) return;
+
+    // Prefer the route pattern (/wallet/balance) over the raw URL so log lines
+    // group cleanly. Query strings are never included.
+    const routePattern = req.route?.path ? `${req.baseUrl}${req.route.path}` : req.originalUrl.split('?')[0];
+    const slowest = stats.slowest ? ` slowest=${stats.slowest.label}:${Math.round(stats.slowest.ms)}ms` : '';
+    console.warn(
+      `[slow-request] ${req.method} ${routePattern} status=${res.statusCode} total=${Math.round(totalMs)}ms ` +
+        `db=${Math.round(stats.dbMs)}ms/${stats.dbQueries}q${slowest}${aborted ? ' CLIENT_GAVE_UP' : ''}`
+    );
+  });
+
+  requestStats.run(stats, next);
+}
+
+/**
+ * Samples event-loop delay. If Node's single thread is busy (synchronous
+ * CPU work such as bcryptjs at cost 12 - it is pure JS), EVERY request slows
+ * down at once even though the database and providers are fine. Logs only
+ * when the loop was noticeably late in the last window.
+ */
+export function startEventLoopMonitor(intervalMs = 30_000) {
+  const histogram = monitorEventLoopDelay({ resolution: 20 });
+  histogram.enable();
+
+  const timer = setInterval(() => {
+    const p50 = histogram.percentile(50) / 1e6;
+    const p99 = histogram.percentile(99) / 1e6;
+    const max = histogram.max / 1e6;
+    if (p99 >= 100 || max >= 500) {
+      console.warn(
+        `[event-loop] lag over last ${Math.round(intervalMs / 1000)}s: p50=${p50.toFixed(0)}ms p99=${p99.toFixed(0)}ms max=${max.toFixed(0)}ms ` +
+          '- the process was CPU-busy; every in-flight request was delayed by this much'
+      );
+    }
+    histogram.reset();
+  }, intervalMs);
+  timer.unref();
+
+  return () => {
+    clearInterval(timer);
+    histogram.disable();
+  };
+}
+
+/**
+ * Prisma sizes its connection pool from the host's physical CPU count
+ * (cores * 2 + 1) unless DATABASE_URL says otherwise. On shared platforms the
+ * reported core count can be far larger than what the Supabase pooler will
+ * hand out, and the default 10s pool_timeout then turns contention into
+ * request failures. Flag the missing settings once at startup.
+ */
+export function warnOnPoolConfig() {
+  try {
+    const params = new URL(env.DATABASE_URL).searchParams;
+    const missing = ['connection_limit', 'pool_timeout'].filter((key) => !params.has(key));
+    if (missing.length > 0) {
+      console.warn(
+        `[db] DATABASE_URL does not set ${missing.join(' / ')}. Recommended for a long-lived server behind the Supabase pooler: ` +
+          '?pgbouncer=true&connection_limit=10&pool_timeout=20 (see .env.example).'
+      );
+    }
+  } catch {
+    // Unparseable URL: Prisma will report its own, clearer error.
+  }
+}
+
+/**
+ * Measures the round trip to the database (SELECT 1 through whatever
+ * DATABASE_URL points at, i.e. the pooler). Every query in the app pays this
+ * latency, and a handler that runs N queries one after another pays it N
+ * times - so a service and database in different regions make EVERY endpoint
+ * slow with no single "slow query" to find.
+ */
+export async function probeDatabaseLatency(samples = 5) {
+  try {
+    const timings: number[] = [];
+    for (let i = 0; i < samples; i += 1) {
+      const startedAt = performance.now();
+      await prisma.$queryRaw`SELECT 1`;
+      timings.push(performance.now() - startedAt);
+    }
+    const sorted = [...timings].sort((a, b) => a - b);
+    const median = sorted[Math.floor(sorted.length / 2)];
+    console.log(
+      `[db] round-trip SELECT 1: min=${sorted[0].toFixed(0)}ms median=${median.toFixed(0)}ms max=${sorted[sorted.length - 1].toFixed(0)}ms (n=${samples}; first sample includes connection setup)`
+    );
+    if (median > 50) {
+      console.warn(
+        `[db] median round trip of ${median.toFixed(0)}ms is high. A database in the same region as this service answers in ~1-10ms. ` +
+          'Check that the Railway service region and the Supabase project region match - every query in every request pays this cost.'
+      );
+    }
+  } catch (error) {
+    console.warn('[db] latency probe failed (non-fatal):', error instanceof Error ? error.message : error);
