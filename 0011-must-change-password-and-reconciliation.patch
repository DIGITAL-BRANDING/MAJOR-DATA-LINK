+        const r = await api.post<{ data: Dynamic; message: string }>('/wallet/fund/dynamic', { amount: Number(amount) });
+        setDynamic(r.data);
+        setMessage(r.message);
+      } else if (method === 'card') {
+        const r = await api.post<{ data: { authorization_url: string } }>('/wallet/fund', {
+          amount: Number(amount),
