+                    backgroundColor: Colors.transparent,
+                    foregroundColor: context.colors.primary,
+                    onPressed: () {
+                      ref.read(asyncFlowProvider.notifier).reset();
+                      _ninController.clear();
+                      stopPolling();
+                    },
+                  ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
