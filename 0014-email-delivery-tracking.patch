+          : `Email sent to ${delivered} recipient${delivered === 1 ? '' : 's'}. Delivery status appears under Recent sends.`
+      ));
+    } catch (e) {
+      res.redirect('/admin/email-composer?flash=' + encodeURIComponent(e instanceof Error ? e.message : 'Could not send email.'));
+    }
+  });
+}
