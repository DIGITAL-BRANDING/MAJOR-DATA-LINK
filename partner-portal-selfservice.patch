+
+ALTER TABLE "Partner"
+  ADD COLUMN "passwordHash" TEXT,
+  ADD COLUMN "passwordFailures" INTEGER NOT NULL DEFAULT 0,
+  ADD COLUMN "passwordFailureAt" TIMESTAMP(3),
+  ADD COLUMN "passwordLockedUntil" TIMESTAMP(3);
