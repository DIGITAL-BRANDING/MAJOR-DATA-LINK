+                          </a>
+                        )}
+                      </span>
+                    </div>
+                    {entry.progress_notes && <p className="mt-1 text-ink-400">{entry.progress_notes}</p>}
+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        </section>
