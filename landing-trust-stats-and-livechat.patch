+import type { ReactNode } from 'react';
+import { Link } from 'react-router-dom';
+import { MessageCircle } from 'lucide-react';
+import { useAuth } from '../lib/auth';
+import { openLiveChat } from '../lib/live-chat-events';
+
+type Props = {
+  /** Shown to signed-in users, who can open the live chat straight away. */
+  label: string;
+  /** Shown to visitors. Live chat is only available once signed in. */
+  signupLabel: string;
+  className?: string;
+  children?: ReactNode;
+};
+
+/**
+ * Support entry point that replaces WhatsApp on the landing page. Signed-in
+ * users open the in-app live chat; visitors are sent to sign up first,
+ * because the live chat service only accepts authenticated customers.
+ */
+export default function LiveChatButton({ label, signupLabel, className }: Props) {
+  const { user } = useAuth();
+  if (user) {
+    return (
+      <button type="button" className={className} onClick={() => openLiveChat()}>
+        <MessageCircle size={15} aria-hidden="true" /> {label}
+      </button>
+    );
+  }
+  return (
+    <Link to="/register" className={className}>
+      <MessageCircle size={15} aria-hidden="true" /> {signupLabel}
+    </Link>
+  );
+}
