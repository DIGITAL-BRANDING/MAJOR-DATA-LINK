+    { label: 'Gender', value: f.gender },
+    { label: 'Reference', value: p.reference },
+    { label: 'Issued', value: formatIssued(p.issuedAt) },
+    ...rest.filter((r) => r.value && r.value.trim() !== '' && r.value !== '****')
