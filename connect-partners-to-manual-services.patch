+    details: z.record(z.string(), z.unknown())
+  }).parse(req.body);
+  const result = await submitPartnerCac({
+    partnerId: req.partner!.id, type: body.type, proposedName1: body.proposed_name_1, proposedName2: body.proposed_name_2,
