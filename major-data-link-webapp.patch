@@ -0,0 +1,72 @@
+@import "tailwindcss";
+
+@theme {
+  /* Brand: Gold / Bronze / Ember - matches the Flutter app's identity */
+  --color-ink: #15100a;
+  --color-ink-soft: #221a10;
+  --color-ink-line: #3a2c16;
+
+  --color-cream: #fffaf0;
+  --color-parchment: #fbf0d9;
+  --color-parchment-line: #eaddb8;
+
+  --color-gold-50: #fffbeb;
+  --color-gold-200: #fce588;
+  --color-gold-400: #f7c948;
+  --color-gold-500: #d4af37;
+  --color-gold-600: #b8941f;
+  --color-gold-700: #9c7a17;
+
+  --color-bronze-500: #c9a227;
+  --color-bronze-700: #855f16;
+
+  --color-ember-400: #ff7b33;
+  --color-ember-500: #ff6b35;
+  --color-ember-600: #e55520;
+
+  --color-success-500: #10b981;
+  --color-success-600: #059669;
+
+  --color-ink-900: #1c140b;
+  --color-ink-600: #5c4d38;
+
+  --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
+  --font-mono: "IBM Plex Mono", ui-monospace, monospace;
+  --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
+}
+
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body {
+  margin: 0;
+  font-family: var(--font-body);
+  background: var(--color-cream);
