+++ b/web/src/components/HeroSlider.css
@@ -0,0 +1,205 @@
+/* Scoped with the .hs prefix and two-class selectors so the page-wide
+   .mdl-landing rules (h1/p/a/img) cannot override the slider. */
+
+.hs {
+  position: relative;
+  overflow: hidden;
+  min-height: 560px;
+  border-radius: 0 0 28px 28px;
+  background: linear-gradient(100deg, #6ef46a 0%, #a6ffa1 55%, #e6ffe2 100%);
+  isolation: isolate;
+}
+
+.hs .hs-slide {
+  position: absolute;
+  inset: 0;
+  opacity: 0;
+  transform: translateX(32px);
+  transition: opacity 0.7s ease, transform 0.7s ease;
+  pointer-events: none;
+  display: flex;
+  align-items: center;
+}
+
+.hs .hs-slide.is-active {
+  opacity: 1;
+  transform: translateX(0);
+  pointer-events: auto;
+}
+
+.hs .hs-inner {
+  width: min(1200px, 92%);
+  margin: 0 auto;
+  display: grid;
+  grid-template-columns: 1.1fr 0.9fr;
+  align-items: center;
+  gap: 24px;
+  padding: 64px 0 72px;
+}
+
+/* Text: rises in when its slide becomes active, each line slightly later. */
+.hs .hs-slide.is-active .hs-text > * {
+  animation: hs-rise 0.7s ease both;
+}
+.hs .hs-slide.is-active .hs-text > :nth-child(2) { animation-delay: 0.12s; }
+.hs .hs-slide.is-active .hs-text > :nth-child(3) { animation-delay: 0.24s; }
+
+.hs .hs-title {
+  margin: 0;
+  font-family: 'Poppins', sans-serif;
+  font-weight: 900;
+  line-height: 1.02;
+  text-transform: uppercase;
+  font-size: clamp(2.2rem, 5.2vw, 4.6rem);
+  color: #111;
+  letter-spacing: -0.5px;
+}
+
+.hs .hs-dark { color: #111; }
+.hs .hs-accent { color: #e11d2e; }
+
+.hs .hs-desc {
+  margin: 22px 0 0;
+  max-width: 540px;
+  font-family: 'Poppins', sans-serif;
+  font-size: clamp(1rem, 1.6vw, 1.15rem);
+  line-height: 1.6;
+  color: #1b1b1b;
+}
+
+.hs .hs-cta {
+  margin-top: 30px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+}
+
+.hs .hs-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 170px;
+  padding: 14px 26px;
+  border-radius: 6px;
+  font-family: 'Poppins', sans-serif;
+  font-weight: 600;
+  font-size: 1rem;
+  text-decoration: none;
+  letter-spacing: 0.3px;
+  transition: transform 0.15s ease, filter 0.15s ease;
+}
+
+.hs .hs-btn:hover { transform: translateY(-2px); filter: brightness(1.08); }
+.hs .hs-btn:focus-visible { outline: 3px solid #e11d2e; outline-offset: 3px; }
+
+.hs .hs-btn-primary { background: #0a0a0a; color: #fff; }
+.hs .hs-btn-secondary { background: #0b2a55; color: #fff; }
+
+.hs .hs-media {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+}
+
+.hs .hs-media img {
+  width: 100%;
+  max-width: 460px;
+  max-height: 420px;
+  object-fit: contain;
+  border-radius: 22px;
+  background: rgba(255, 255, 255, 0.55);
+  box-shadow: 0 18px 40px rgba(0, 60, 0, 0.18);
+  padding: 12px;
+}
+
+.hs .hs-slide.is-active .hs-media img {
+  animation: hs-zoom 1.1s ease both;
+}
+
+/* Arrows */
+.hs .hs-arrow {
+  position: absolute;
+  top: 50%;
+  transform: translateY(-50%);
+  z-index: 3;
+  width: 46px;
+  height: 46px;
+  border: 0;
+  border-radius: 50%;
+  background: #e11d2e;
+  color: #fff;
+  font-size: 30px;
+  line-height: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
+  transition: transform 0.15s ease, background 0.15s ease;
+}
+.hs .hs-arrow:hover { background: #b9111f; }
+.hs .hs-arrow:focus-visible { outline: 3px solid #111; outline-offset: 3px; }
+.hs .hs-prev { left: 14px; }
+.hs .hs-next { right: 14px; }
+
+/* Dots, top-right on desktop like the reference, centred on small screens */
+.hs .hs-dots {
+  position: absolute;
+  top: 18px;
+  right: 24px;
+  z-index: 3;
+  display: flex;
+  gap: 10px;
+}
+
+.hs .hs-dot {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  border: 0;
+  padding: 0;
+  background: rgba(0, 0, 0, 0.25);
+  cursor: pointer;
+  transition: background 0.2s ease, transform 0.2s ease;
+}
+.hs .hs-dot.is-active { background: #e11d2e; transform: scale(1.15); }
+.hs .hs-dot:focus-visible { outline: 2px solid #111; outline-offset: 2px; }
+
+@keyframes hs-rise {
+  from { opacity: 0; transform: translateY(18px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes hs-zoom {
+  from { opacity: 0; transform: scale(0.94); }
+  to { opacity: 1; transform: scale(1); }
+}
+
+/* Small screens: stack text above the picture, centre the copy */
+@media (max-width: 860px) {
+  .hs { min-height: 0; }
+  .hs .hs-slide { position: relative; display: none; }
+  .hs .hs-slide.is-active { display: flex; }
+  .hs .hs-inner {
+    grid-template-columns: 1fr;
+    padding: 56px 0 84px;
+    text-align: center;
+    gap: 28px;
+  }
+  .hs .hs-desc { margin-left: auto; margin-right: auto; }
+  .hs .hs-cta { justify-content: center; }
+  .hs .hs-media img { max-height: 280px; }
+  .hs .hs-dots { top: auto; bottom: 22px; right: 0; left: 0; justify-content: center; }
+  .hs .hs-arrow { top: auto; bottom: 14px; transform: none; width: 40px; height: 40px; font-size: 26px; }
+  .hs .hs-prev { left: 14px; }
+  .hs .hs-next { right: 14px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hs .hs-slide,
+  .hs .hs-dot,
+  .hs .hs-btn,
+  .hs .hs-arrow { transition: none; }
+  .hs .hs-slide.is-active .hs-text > *,
+  .hs .hs-slide.is-active .hs-media img { animation: none; }
+}
